export struct MyTreeItem {
    id: int,
    text: string,
    depth: int,
    is_last: bool,
    has_children: bool,
    is_expanded: bool,
    is_editing: bool,
    parent_is_last: bool,
    is_selected: bool,
    note: string,
    text_width: float,
    smart_id: string,
    line_mask: [int],
    parent_id: int,
    parent_triangle_x: float,
    parent_triangle_y: float,
    self_triangle_x: float,
    self_triangle_y: float,
}

export struct CADLine {
    id: int,
    id_obj1: int,
    id_obj2: int,
    x1: float,
    y1: float,
    x2: float,
    y2: float,
    tree_id_1: int,
    tree_id_2: int,
    side1: int,
    side2: int,
    mid_x: float,
}

export struct NodeLinkInfo { id: int, target_node_id: int, target_node_name: string }
export struct NodeNoteInfo { node_id: int, node_name: string, note_index: int, note_text: string }
// is_selected — выбрано ли дерево целиком (клик/Ctrl+клик по кружку).
// Считается на стороне Rust в update_ui_models, не в Slint.
export struct SlintCADTree { id: int, cad_x: float, cad_y: float, width: float, count: int, data: [MyTreeItem], is_selected: bool }
